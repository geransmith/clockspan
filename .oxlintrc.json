{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // `typeAware` runs the `typescript/*` rules that need type information through
  // oxlint-tsgolint (TypeScript 7's checker); `npm run typecheck` is still the type check.
  // oxlint ignores a misspelled rule name without a word; check `npx oxlint --print-config`
  // after editing this file.
  "plugins": ["typescript", "react", "jsx-a11y", "oxc", "unicorn"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "node": true },
  "options": { "typeAware": true },
  "rules": {
    // `_`-prefixed names are the convention for "deliberately unused" (rest-destructuring a
    // row to drop columns, unused handler params).
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }],
    // lib/alerts.ts exports an alert() with the browser's name, and lib.dom's alert takes
    // `any`, so a call that lost its import still type-checks and opens a dialog reading
    // "[object Object]". The imported alert is a module binding, which this rule leaves alone.
    // no-alert would also refuse the window.confirm calls the app makes on purpose.
    "no-restricted-globals": ["error", { "name": "alert", "message": "Import alert from client/src/lib/alerts; the browser's alert() is never used." }],
    // The hooks rules the app relies on, the React Compiler ones included. Each line turns its
    // rule on whatever its category. rules-of-hooks is in no category this config enables, so
    // its line is what turns it on; the rest are also in correctness and are listed so an
    // oxlint upgrade that moves one out can't drop it. correctness also brings
    // incompatible-library.
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/refs": "error",
    "react-hooks/set-state-in-effect": "error",
    "react-hooks/set-state-in-render": "error",
    "react-hooks/purity": "error",
    "react-hooks/immutability": "error",
    "react-hooks/static-components": "error",
    "react-hooks/use-memo": "error",
    "react-hooks/preserve-manual-memoization": "error",
    "react-hooks/error-boundaries": "error",
    "react-hooks/globals": "error",
    // Type-aware rules for the bugs type checking lets through: promises nobody awaits or
    // catches, async functions handed to something that ignores what they return, values that
    // stringify as "[object Object]", non-Error throws, switches that miss a union member.
    // no-unsafe-*: Express's `req.body` is `any`, and these refuse reading a field off it
    // before it is checked (cast it to `{ field?: unknown }`, as the routes do). Off for tests
    // and the plain-JavaScript scripts (see the override below).
    // Left off: no-unnecessary-condition (it wants the guard on `navigator.serviceWorker` gone,
    // which the runtime can still leave undefined), and the style rules
    // (strict-boolean-expressions, promise-function-async, …).
    // Each line turns its rule on. no-deprecated, no-misused-promises, no-unsafe-* (but
    // no-unsafe-unary-minus), only-throw-error, prefer-promise-reject-errors,
    // restrict-plus-operands, return-await, switch-exhaustiveness-check and
    // use-unknown-in-catch-callback-variable are in no category this config enables, so their
    // lines are what turn them on; the rest are also in correctness and are listed so an oxlint
    // upgrade that moves one out can't drop it.
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    // The toggle-row pattern nests its text two spans deep inside the label, and UsernameInput
    // renders the <input> a label wraps.
    "jsx-a11y/label-has-associated-control": ["error", { "depth": 3, "controlComponents": ["UsernameInput"] }],
    // Off on purpose: `role="group"`, `role="status"` and `role="img"` on a div, span or p are
    // valid ARIA; the rule would want <fieldset>, <output> and <img> for them.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Off on purpose: autoFocus only moves focus where the user's own action expects it: a
    // page's first field, an input just opened for editing, the control an edit returns to, a
    // field remounted to keep focus.
    "jsx-a11y/no-autofocus": "off"
  },
  "overrides": [
    { "files": ["client/public/sw.js"], "env": { "serviceworker": true } },
    {
      // The harness hands tests their JSON as `any` so a test reads a field without a cast;
      // the scripts and the service worker are plain JavaScript with no types to check.
      "files": ["**/*.test.ts", "scripts/**", "client/public/sw.js"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}
