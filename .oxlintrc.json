{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // `typeAware` runs the `typescript/*` rules that need type information through
  // oxlint-tsgolint (TypeScript 7's checker); `npm run typecheck` is still the type check.
  // oxlint ignores a misspelled rule name without a word; check `npx oxlint --print-config`
  // after editing this file.
  "plugins": ["typescript", "react", "jsx-a11y", "oxc", "unicorn"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "node": true },
  "options": { "typeAware": true },
  "ignorePatterns": ["dist/", "node_modules/", "data/", "docs/", "coverage/"],
  "rules": {
    // `_`-prefixed names are the convention for "deliberately unused" (rest-destructuring a
    // row to drop columns, unused handler params).
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }],
    // The automatic JSX runtime needs no React import.
    "react/react-in-jsx-scope": "off",
    // eslint-plugin-react-hooks' recommended set, including the React Compiler rules.
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/refs": "error",
    "react-hooks/set-state-in-effect": "error",
    "react-hooks/set-state-in-render": "error",
    "react-hooks/purity": "error",
    "react-hooks/immutability": "error",
    "react-hooks/static-components": "error",
    "react-hooks/use-memo": "error",
    "react-hooks/preserve-manual-memoization": "error",
    "react-hooks/error-boundaries": "error",
    "react-hooks/globals": "error",
    // Type-aware rules for the bugs type checking lets through: promises nobody awaits or
    // catches, async functions handed to something that ignores what they return, values that
    // stringify as "[object Object]", non-Error throws, switches that miss a union member.
    // no-unsafe-*: Express's `req.body` is `any`, and these refuse reading a field off it
    // before it is checked (cast it to `{ field?: unknown }`, as the routes do). Off for tests
    // and the plain-JavaScript scripts (see the override below).
    // Left off: no-unnecessary-condition (it wants the guards on `req.body` and
    // `navigator.serviceWorker` gone, which the runtime can still leave undefined), and the
    // style rules (strict-boolean-expressions, promise-function-async, …).
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    // The toggle-row pattern nests its text two spans deep inside the label, and UsernameInput
    // renders the <input> a label wraps.
    "jsx-a11y/label-has-associated-control": ["error", { "depth": 3, "controlComponents": ["UsernameInput"] }],
    // Off on purpose: `role="group"`, `role="status"` and `role="img"` on a div, span or p are
    // valid ARIA; the rule would want <fieldset>, <output> and <img> for them.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Off on purpose: the five uses are the first field of the three sign-in pages (sign in,
    // setup, new password) and two edit-in-place inputs the user just opened, where moving
    // focus there is the expected behaviour.
    "jsx-a11y/no-autofocus": "off"
  },
  "overrides": [
    { "files": ["client/public/sw.js"], "env": { "serviceworker": true } },
    {
      // The harness hands tests their JSON as `any` so a test reads a field without a cast;
      // the scripts and the service worker are plain JavaScript with no types to check.
      "files": ["**/*.test.ts", "scripts/**", "client/public/sw.js"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}
