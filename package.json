{
  "name": "clockspan",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "description": "Work smart, not hard. A self-hosted one-page focus sheet for ADHD: punch clock with lunch and clock-out alarms, the day's top priorities, and a Pomodoro-style timer that logs what you did.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=3000 tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx server/dev/seed-cli.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.test.json",
    "lint": "oxlint",
    "reset-password": "tsx server/cli.ts reset-password"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@internationalized/date": "3.12.4",
    "better-sqlite3": "13.0.3",
    "cookie": "2.0.1",
    "express": "5.2.1",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-dom": "19.3.0",
    "react-stately": "3.50.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "10.0.5",
    "oxlint": "1.83.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
