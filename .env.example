# Copy to .env for local runs (`npm start` reads it via your shell, e.g. `set -a; . ./.env; set +a`).
# In Docker, set these in docker-compose.yml instead.

PORT=8080
DATA_DIR=./data

# none | local | oidc
AUTH_MODE=none

# Public URL of the app. Required for oidc; used to derive the OIDC redirect URI and
# whether cookies should be Secure.
#APP_URL=https://focus.example.com

# Behind a reverse proxy: how many proxies sit in front (usually 1), so rate limiting and
# secure cookies see the real client. Avoid "true": it trusts any X-Forwarded-For header.
#TRUST_PROXY=1
#COOKIE_SECURE=true

# Session lifetime in days (sliding). Default 30.
#SESSION_TTL_DAYS=30

# Server-wide ceiling on history, in days (30 or more): every user's older days are deleted
# every few hours. Unset keeps everything; users can pick a shorter limit in Settings → Data.
#RETENTION_DAYS=730

# OIDC (Authentik or any OpenID Connect provider)
#OIDC_ISSUER=https://auth.example.com/application/o/clockspan/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email

# Docker only: own /data and run as this user/group (image default 1000/1000; Unraid uses 99/100).
#PUID=99
#PGID=100
