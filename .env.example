# Clockspan configuration. Copy this file to .env next to docker-compose.yml; Compose passes
# it to the container. A commented-out line leaves the image default.
# Running from source instead? Export the same names before `npm start`, e.g.
# `set -a; . ./.env; set +a`. PORT (8080 in the image, 3000 otherwise) and DATA_DIR
# (/data in the image, ./data otherwise) are fixed by the image, so they are not listed here.

# none  = no sign-in (LAN, or behind your own proxy auth)
# local = the first visit creates the admin account; the admin adds users in Settings
# oidc  = sign in with Authentik or any OpenID Connect provider (needs APP_URL + the OIDC_* block)
AUTH_MODE=none

# Public URL of the app. Required for oidc; recommended whenever you reach the app through a
# domain. https makes the session cookie Secure and turns on HSTS. Must match the redirect
# URI registered in your provider: ${APP_URL}/auth/callback
#APP_URL=https://focus.example.com

# Behind a reverse proxy (Nginx Proxy Manager, SWAG, Traefik): the number of proxies between
# the internet and the container, usually 1. Not "true": that trusts whatever X-Forwarded-For
# a client sends, which defeats the login rate limit.
#TRUST_PROXY=1

# Force the session cookie's Secure flag. Defaults to true when APP_URL is https.
#COOKIE_SECURE=true

# Sliding session lifetime in days. Default 30.
#SESSION_TTL_DAYS=30

# Server-wide ceiling on history, in days (30 or more): every user's older days are deleted
# every few hours. Unset keeps everything; users can pick a shorter limit in Settings → Data.
#RETENTION_DAYS=730

# OIDC. Authentik: Providers → your provider → "OpenID Configuration Issuer".
#OIDC_ISSUER=https://auth.example.com/application/o/clockspan/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES="openid profile email"

# Docker only. DATA_PATH is read by docker-compose.yml: the host directory that holds the
# database (Unraid: /mnt/user/appdata/clockspan). PUID/PGID own it and run the app; match the
# directory's owner (Unraid: 99/100). 0 keeps root.
#DATA_PATH=./data
#PUID=1000
#PGID=1000
