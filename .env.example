# Copy to .env for local runs (`npm start` reads it via your shell, e.g. `set -a; . ./.env; set +a`).
# In Docker, set these in docker-compose.yml instead.

PORT=8080
DATA_DIR=./data

# none | local | oidc
AUTH_MODE=none

# Public URL of the app. Required for oidc; used to derive the OIDC redirect URI and
# whether cookies should be Secure.
#APP_URL=https://focus.example.com

# Behind a reverse proxy: "true" or a hop count. Makes rate limiting and secure cookies
# see the real client.
#TRUST_PROXY=true
#COOKIE_SECURE=true

# Session lifetime in days (sliding). Default 30.
#SESSION_TTL_DAYS=30

# OIDC (Authentik or any OpenID Connect provider)
#OIDC_ISSUER=https://auth.example.com/application/o/clockspan/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email

# Docker only: run as this user/group and own /data (Unraid uses 99/100).
#PUID=99
#PGID=100
